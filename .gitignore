# ============================================================
# MAGPAI .gitignore - v1.0
# ============================================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.python-version
.eggs/
*.egg-info/
pip-wheel-metadata/
.pytest_cache/
.hypothesis/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/

# Streamlit / app-local config
.streamlit/secrets.toml
.streamlit/config.local.toml

# VS Code local/private settings
.vscode/settings.local.json

# Generated documentation/site output
site/
build/
dist/

# Reports
reports/generated/*
reports/coverage/*
reports/profiling/*
!reports/generated/.gitkeep
!reports/coverage/.gitkeep
!reports/profiling/.gitkeep

# TensorBoard / PyTorch runs
runs/*
!runs/.gitkeep

# Model checkpoints and exports
models/checkpoints/*
models/exports/*
!models/checkpoints/.gitkeep
!models/exports/.gitkeep

# Generated data
data/generated/*
!data/generated/.gitkeep

# Logs
*.log
logs/

# Local databases and runtime state
*.db
*.sqlite
*.sqlite3

# PowerPoint / Office temporary files
~$*.pptx
~$*.docx
~$*.xlsx

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# Do not commit local caches
.cache/
.uv-cache/

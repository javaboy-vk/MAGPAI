{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MAGPAI - Debug Current Python File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "MAGPAI - Chatbot",
      "type": "debugpy",
      "request": "launch",
      "module": "magpai.chatbot",
      "args": [],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "MAGPAI - Chatbot Trace",
      "type": "debugpy",
      "request": "launch",
      "module": "magpai.chatbot",
      "args": [
        "--trace"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "MAGPAI - FastAPI Local Gateway",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "apps.fastapi.local_ai_gateway_app:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "18081"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "MAGPAI - Streamlit Token Visualizer",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "apps/streamlit/token_visualizer_app.py"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
